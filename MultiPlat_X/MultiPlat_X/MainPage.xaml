<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MultiPlat_X.MainPage">

    <StackLayout>
        <Frame BackgroundColor="#2196F3" Padding="24" CornerRadius="0">
            <Label Text="MultiPlat" HorizontalTextAlignment="Center" TextColor="White" FontSize="36"/>
        </Frame>

        <Image
            Source="mysql.png"
            Margin="20"/>
        <StackLayout
            HorizontalOptions="CenterAndExpand"
            Orientation="Horizontal">
            <Button 
                Text="Cadastrar"
                TextColor="Black"
                BackgroundColor="White"
                FontAttributes="Bold"
                x:Name="btnCadastrar"
                Clicked="btnCadastrar_Clicked_1"/>
            <Button 
                Text="Listar"
                TextColor="Black"
                BackgroundColor="White"
                FontAttributes="Bold"
                x:Name="btnListar"
                Clicked="btnListar_Clicked"/>
            <Button 
                Text="Sair"
                TextColor="White"
                BackgroundColor="Red"
                FontAttributes="Bold"
                CornerRadius="20"
                x:Name="btnSair"
                Clicked="btnSair_Clicked"/>
        </StackLayout>
    </StackLayout>

</ContentPage>
