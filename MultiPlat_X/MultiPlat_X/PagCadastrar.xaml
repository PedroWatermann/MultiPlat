<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MultiPlat_X.PagCadastrar"
             Title="Cadastrar">
    <ContentPage.Content>
        <StackLayout Padding="15">
            <Label
                Text="Nome: "
                FontSize="20"
                FontAttributes="Bold"/>
            <Entry
                x:Name="entNome"
                Keyboard="Default"/>

            <Label
                Text="Cidade: "
                FontSize="20"
                FontAttributes="Bold"/>
            <Entry
                x:Name="entCidade"
                Keyboard="Default"/>

            <Label
                Text="Celular: "
                FontSize="20"
                FontAttributes="Bold"/>
            <Entry
                x:Name="entCelular"
                Keyboard="Numeric"/>

            <Button
                Text="Cadastrar"
                BackgroundColor="White"
                FontAttributes="Bold"
                BorderWidth="2"
                BorderColor="Black"
                CornerRadius="50"
                HorizontalOptions="FillAndExpand"
                x:Name="btnCadastrar"
                Clicked="btnCadastrar_Clicked"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>